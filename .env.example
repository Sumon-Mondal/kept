# PayPal REST app credentials. Sandbox only.
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Kept calls https://api-m.sandbox.paypal.com and ignores live hosts.
# Leave both blank to run the full demo with on-device captures (ids start with DEMO-).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional OpenAI-compatible chat completions API.
# Leave AI_API_KEY blank to use the on-device clerk. The demo still prices, flags, and checks out.
# Groq example: AI_BASE_URL=https://api.groq.com/openai/v1 and AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
